{
  "name": "ledger-token-sync",
  "displayName": "Ledger — Token Sync",
  "description": "Synchronise automatiquement ta consommation de tokens Claude Code vers ton serveur Ledger, directement depuis VS Code.",
  "version": "0.3.5",
  "publisher": "ledger-local",
  "repository": {
    "type": "git",
    "url": "https://github.com/FabrichJean/c-sha.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ledger.configure",
        "title": "Ledger: Configurer le serveur"
      },
      {
        "command": "ledger.refresh",
        "title": "Ledger: Rafraîchir maintenant",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "ledger.refresh",
          "when": "view == ledger.usagePanel",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Ledger",
      "properties": {
        "ledger.serverUrl": {
          "type": "string",
          "default": "",
          "description": "URL du serveur Ledger (ex: https://ledger.mondomaine.com). Modifiable ici ou via la commande \"Ledger: Configurer le serveur\". La clé API de sync ne se configure que via cette commande — jamais dans ce fichier de paramètres, qui peut être synchronisé ou partagé."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ledger",
          "title": "Ledger",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "ledger": [
        {
          "type": "webview",
          "id": "ledger.usagePanel",
          "name": "Conso de ce projet"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node esbuild.js",
    "watch": "node esbuild.js --watch",
    "typecheck": "tsc -p ./ --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.4.0"
  }
}
